<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Anupam Ojha — Platform & Infrastructure Engineer</title>
  <meta name="description" content="Senior Platform & Infrastructure Engineer with 15+ years building secure, scalable Kubernetes infrastructure and DevSecOps pipelines." />
</head>
<body>

<nav class="nav">
  <div class="container nav-inner">
    <a href="#" class="nav-logo">AO</a>
    <div class="nav-links">
      <a href="#sentinel">Sentinel</a>
      <a href="#experience">Experience</a>
      <a href="#skills">Skills</a>
      <a href="#fit">Job Fit</a>
      <a href="mailto:anupam.platform@gmail.com" class="nav-cta">Contact</a>
    </div>
  </div>
</nav>

<main>

  <section class="hero">
    <div class="container">
      <p class="hero-eyebrow">Senior Platform &amp; Infrastructure Engineer</p>
      <h1 class="hero-name">Anupam Ojha</h1>
      <p class="hero-bio">15+ years building secure, scalable platform infrastructure. Kubernetes orchestration, OpenTelemetry observability, and DevSecOps at Ford Motor Company and GE Healthcare.</p>
      <div class="hero-actions">
        <a href="https://github.com/anupamojha-eng" target="_blank" rel="noopener" class="btn btn-primary">GitHub</a>
        <a href="https://www.linkedin.com/in/anupamojha" target="_blank" rel="noopener" class="btn btn-outline">LinkedIn</a>
      </div>
    </div>
  </section>

  <section id="sentinel" class="section">
    <div class="container">
      <p class="section-label">Featured Project</p>
      <div class="sentinel-card">
        <div class="sentinel-header">
          <div>
            <h2 class="sentinel-title">Sentinel</h2>
            <p class="sentinel-subtitle">Autonomous CVE Remediation Agent</p>
          </div>
          <a href="https://github.com/anupamojha-eng/agentic-remediation-factory" target="_blank" rel="noopener" class="btn btn-outline btn-sm">View on GitHub →</a>
        </div>
        <p class="sentinel-desc">Most security tools find vulnerabilities. Sentinel fixes them — autonomously, with a verified PR.</p>
        <div class="sentinel-steps">
          <div class="step"><span class="step-num">1</span><span>Forks the repo and resolves the full dependency tree, including transitive CVEs via OSV API</span></div>
          <div class="step"><span class="step-num">2</span><span>Patches build files <em>and</em> dangerous call sites in source code via LLM</span></div>
          <div class="step"><span class="step-num">3</span><span>Verifies the build passes in an isolated Docker sandbox</span></div>
          <div class="step"><span class="step-num">4</span><span>Opens a pull request — no human in the loop</span></div>
        </div>
        <div class="sentinel-prs">
          <p class="sentinel-prs-label">Live PRs</p>
          <div class="pr-links">
            <a href="https://github.com/anupamojha-eng/vulnerable-data-pipeline/pull/2" target="_blank" rel="noopener" class="pr-link">
              <span class="pr-badge python">Python</span>
              yaml.load() RCE → yaml.safe_load(), PyYAML upgraded, pickle → JSON
            </a>
            <a href="https://github.com/monitorjbl/excel-streaming-reader/pull/271" target="_blank" rel="noopener" class="pr-link">
              <span class="pr-badge java">Java</span>
              log4j-core 2.14.1 → 2.17.1
            </a>
          </div>
        </div>
        <div class="tags">
          <span class="tag">Python</span>
          <span class="tag">Java</span>
          <span class="tag">Docker</span>
          <span class="tag">LLM</span>
          <span class="tag">DevSecOps</span>
          <span class="tag">Anthropic Claude</span>
          <span class="tag">Google Gemini</span>
          <span class="tag">OSV API</span>
        </div>
      </div>
    </div>
  </section>

  <section id="skills" class="section section-alt">
    <div class="container">
      <p class="section-label">Technical Skills</p>
      <div class="skills-grid">
        <div class="skill-group">
          <h3 class="skill-group-title">Cloud &amp; Platform</h3>
          <div class="tags">
            <span class="tag">AWS</span><span class="tag">GCP</span><span class="tag">Kubernetes</span>
            <span class="tag">Docker</span><span class="tag">Terraform</span><span class="tag">Crossplane</span>
            <span class="tag">Istio</span>
          </div>
        </div>
        <div class="skill-group">
          <h3 class="skill-group-title">Observability</h3>
          <div class="tags">
            <span class="tag">OpenTelemetry</span><span class="tag">Grafana</span>
            <span class="tag">Prometheus</span><span class="tag">Datadog</span><span class="tag">Honeycomb</span>
          </div>
        </div>
        <div class="skill-group">
          <h3 class="skill-group-title">Languages &amp; Frameworks</h3>
          <div class="tags">
            <span class="tag">Java</span><span class="tag">Go</span><span class="tag">Python</span>
            <span class="tag">Spring Boot</span><span class="tag">gRPC</span>
            <span class="tag">GraphQL</span><span class="tag">Kafka</span>
          </div>
        </div>
        <div class="skill-group">
          <h3 class="skill-group-title">CI/CD &amp; Security</h3>
          <div class="tags">
            <span class="tag">GitHub Actions</span><span class="tag">ArgoCD</span>
            <span class="tag">Jenkins</span><span class="tag">Chainguard</span><span class="tag">SAST</span>
          </div>
        </div>
        <div class="skill-group">
          <h3 class="skill-group-title">Databases</h3>
          <div class="tags">
            <span class="tag">Postgres</span><span class="tag">YugabyteDB</span>
            <span class="tag">Redis</span><span class="tag">MongoDB</span><span class="tag">MySQL</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="experience" class="section">
    <div class="container">
      <p class="section-label">Experience</p>
      <div class="experience-list">

        <div class="exp-item">
          <div class="exp-header">
            <div>
              <h3 class="exp-role">Senior Software Engineer</h3>
              <p class="exp-company">Ford Motor Company</p>
            </div>
            <span class="exp-period">Jun 2022 – Present</span>
          </div>
          <ul class="exp-bullets">
            <li>Standardized enterprise observability with unified OpenTelemetry libraries in Java and Go; built PII redaction and a local Otel testing library for realistic integration testing</li>
            <li>Led transition from KubeVela to a custom OAM-based hydrator for automated orchestration of Yugabyte, Pulsar, and Redis</li>
            <li>Enforced secure-by-default pipelines with Chainguard image hardening and build-breaker logic mandating security headers (CSP/XFO/HSTS)</li>
            <li>Reduced command cancellations by 33% via pod-based internal load balancing that rewarded healthy pods and penalized failing nodes</li>
            <li>Served as Incident Commander for platform outages, coordinating multi-team responses and embedding post-mortem lessons into runbooks</li>
          </ul>
        </div>

        <div class="exp-item">
          <div class="exp-header">
            <div>
              <h3 class="exp-role">Staff Software Engineer</h3>
              <p class="exp-company">GE Healthcare</p>
            </div>
            <span class="exp-period">May 2019 – Jun 2022</span>
          </div>
          <ul class="exp-bullets">
            <li>Led two engineering teams building microservice-based hospital monitoring solutions at Tampa General Hospital and OHSU Portland</li>
            <li>Created Gremlin chaos attacks replicating production pod disruptions; ensured graceful degradation of critical clinical clients</li>
            <li>Designed high-throughput EMR/EHR and HL7 data ingestion pipelines using Spring Batch and RabbitMQ</li>
            <li>Built a GraphQL data store for ML teams querying predictive models across ICU, Surgery, and Maternity departments</li>
          </ul>
        </div>

        <div class="exp-item">
          <div class="exp-header">
            <div>
              <h3 class="exp-role">Consulting Roles</h3>
              <p class="exp-company">Citi Group · Verizon · US Bank · Daimler Trucks · Southwest Airlines / Walgreens</p>
            </div>
            <span class="exp-period">2010 – 2019</span>
          </div>
          <ul class="exp-bullets">
            <li>Migrated legacy monoliths to Spring Boot microservices at Verizon; implemented Quick-hull algorithms for geofencing</li>
            <li>Led Sabre-to-Amadeus reservation system migration at Southwest Airlines; built automated validation tools saving $36k/year</li>
            <li>Integrated Eclipse RCP with IBM MQ to automate truck part documentation for Mercedes engineers globally (Daimler)</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <p class="section-label">Education</p>
      <div class="edu-list">
        <div class="edu-item">
          <div>
            <h3 class="edu-degree">MS, Computer Science (Data Science)</h3>
            <p class="edu-school">University of Illinois Urbana-Champaign</p>
          </div>
          <span class="edu-gpa">GPA 3.8</span>
        </div>
        <div class="edu-item">
          <div>
            <h3 class="edu-degree">BTech, Electronics &amp; Communications Engineering</h3>
            <p class="edu-school">SRM University, India</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="fit" class="section">
    <div class="container">
      <p class="section-label">Recruiter Tool</p>
      <h2 class="section-heading">Job Fit Checker</h2>
      <p class="section-subheading">Paste a job description below to see how Anupam's background aligns with the role.</p>
      <div class="fit-form">
        <textarea id="jd-input" placeholder="Paste the job description here..." rows="8"></textarea>
        <button id="fit-btn" class="btn btn-primary">Check Fit</button>
        <div id="fit-result" class="fit-result hidden">
          <p id="fit-loading" class="fit-loading hidden">Analyzing...</p>
          <p id="fit-text"></p>
        </div>
      </div>
    </div>
  </section>

</main>

<footer class="footer">
  <div class="container footer-inner">
    <p>Anupam Ojha · <a href="mailto:anupam.platform@gmail.com">anupam.platform@gmail.com</a></p>
    <div class="footer-links">
      <a href="https://github.com/anupamojha-eng" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/anupamojha" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
</footer>

<script>
  document.getElementById('fit-btn')?.addEventListener('click', async () => {
    const input = document.getElementById('jd-input') as HTMLTextAreaElement;
    const btn = document.getElementById('fit-btn') as HTMLButtonElement;
    const result = document.getElementById('fit-result')!;
    const loading = document.getElementById('fit-loading')!;
    const text = document.getElementById('fit-text')!;

    const jd = input?.value?.trim();
    if (!jd) return;

    btn.disabled = true;
    btn.textContent = 'Analyzing...';
    result.classList.remove('hidden');
    loading.classList.remove('hidden');
    text.textContent = '';

    try {
      const res = await fetch('/api/job-fit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ jobDescription: jd }),
      });
      const data = await res.json();
      loading.classList.add('hidden');
      if (data.fallback || !data.analysis) {
        text.innerHTML = 'Automated analysis is temporarily unavailable. <a href="mailto:anupam.platform@gmail.com?subject=Job%20Fit%20Inquiry">Email me the job description</a> and I\'ll respond personally.';
      } else {
        text.textContent = data.analysis;
      }
    } catch {
      loading.classList.add('hidden');
      text.innerHTML = 'Automated analysis is temporarily unavailable. <a href="mailto:anupam.platform@gmail.com?subject=Job%20Fit%20Inquiry">Email me the job description</a> and I\'ll respond personally.';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Check Fit';
    }
  });
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --text: #111827;
    --text-soft: #6b7280;
    --accent: #1d4ed8;
    --accent-light: #eff6ff;
    --border: #e5e7eb;
    --bg: #ffffff;
    --bg-alt: #f9fafb;
    --radius: 10px;
    --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
  }

  body {
    font-family: var(--font);
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
    font-size: 16px;
  }

  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  .container { max-width: 880px; margin: 0 auto; padding: 0 24px; }

  /* Nav */
  .nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.93);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .nav-logo { font-weight: 700; font-size: 1.1rem; color: var(--text); letter-spacing: -0.02em; }
  .nav-logo:hover { text-decoration: none; }
  .nav-links { display: flex; gap: 28px; align-items: center; font-size: 0.9rem; }
  .nav-links a { color: var(--text-soft); }
  .nav-links a:hover { color: var(--text); text-decoration: none; }
  .nav-cta {
    background: var(--accent) !important; color: white !important;
    padding: 6px 14px; border-radius: 6px; font-weight: 500;
  }
  .nav-cta:hover { text-decoration: none !important; opacity: 0.88; }

  /* Hero */
  .hero { padding: 80px 0 72px; border-bottom: 1px solid var(--border); }
  .hero-eyebrow {
    font-size: 0.82rem; font-weight: 600; color: var(--accent);
    text-transform: uppercase; letter-spacing: 0.09em; margin-bottom: 12px;
  }
  .hero-name {
    font-size: 3rem; font-weight: 700; letter-spacing: -0.03em;
    line-height: 1.1; margin-bottom: 18px;
  }
  .hero-bio {
    font-size: 1.05rem; color: var(--text-soft);
    max-width: 560px; margin-bottom: 28px; line-height: 1.65;
  }
  .hero-actions { display: flex; gap: 12px; }

  /* Buttons */
  .btn {
    display: inline-flex; align-items: center;
    padding: 10px 20px; border-radius: 7px;
    font-size: 0.9rem; font-weight: 500;
    cursor: pointer; border: none;
    transition: opacity 0.15s; text-decoration: none; white-space: nowrap;
  }
  .btn:hover { text-decoration: none; opacity: 0.85; }
  .btn-primary { background: var(--accent); color: white; }
  .btn-outline { background: transparent; color: var(--accent); border: 1.5px solid var(--accent); }
  .btn-sm { padding: 7px 13px; font-size: 0.83rem; }

  /* Sections */
  .section { padding: 72px 0; }
  .section-alt { background: var(--bg-alt); }
  .section-label {
    font-size: 0.75rem; font-weight: 600; color: var(--accent);
    text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;
  }
  .section-heading { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 8px; }
  .section-subheading { color: var(--text-soft); margin-bottom: 24px; font-size: 0.95rem; }

  /* Sentinel */
  .sentinel-card {
    border: 1.5px solid var(--border); border-radius: var(--radius);
    padding: 32px; background: var(--bg);
  }
  .sentinel-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 16px; margin-bottom: 14px; flex-wrap: wrap;
  }
  .sentinel-title { font-size: 1.45rem; font-weight: 700; letter-spacing: -0.02em; }
  .sentinel-subtitle { font-size: 0.88rem; color: var(--text-soft); margin-top: 3px; }
  .sentinel-desc { color: var(--text-soft); font-size: 0.97rem; margin-bottom: 22px; line-height: 1.6; }
  .sentinel-steps { display: flex; flex-direction: column; gap: 10px; margin-bottom: 26px; }
  .step { display: flex; align-items: flex-start; gap: 12px; font-size: 0.92rem; }
  .step-num {
    display: flex; align-items: center; justify-content: center;
    min-width: 22px; height: 22px; background: var(--accent-light); color: var(--accent);
    border-radius: 50%; font-size: 0.72rem; font-weight: 700; flex-shrink: 0; margin-top: 2px;
  }
  .sentinel-prs { margin-bottom: 22px; }
  .sentinel-prs-label {
    font-size: 0.75rem; font-weight: 600; color: var(--text-soft);
    text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px;
  }
  .pr-links { display: flex; flex-direction: column; gap: 8px; }
  .pr-link {
    display: flex; align-items: center; gap: 10px; font-size: 0.88rem; color: var(--text);
    padding: 10px 14px; border: 1px solid var(--border); border-radius: 7px;
    background: var(--bg-alt); transition: border-color 0.15s;
  }
  .pr-link:hover { border-color: var(--accent); text-decoration: none; color: var(--text); }
  .pr-badge {
    font-size: 0.7rem; font-weight: 600; padding: 2px 8px;
    border-radius: 4px; white-space: nowrap;
  }
  .pr-badge.python { background: #fef3c7; color: #92400e; }
  .pr-badge.java { background: #fee2e2; color: #991b1b; }

  /* Tags */
  .tags { display: flex; flex-wrap: wrap; gap: 7px; }
  .tag {
    background: var(--bg-alt); border: 1px solid var(--border);
    padding: 3px 10px; border-radius: 5px; font-size: 0.8rem; color: var(--text-soft);
  }

  /* Skills */
  .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 28px; }
  .skill-group-title { font-size: 0.83rem; font-weight: 600; color: var(--text); margin-bottom: 10px; }

  /* Experience */
  .experience-list { display: flex; flex-direction: column; gap: 36px; }
  .exp-item { padding-bottom: 36px; border-bottom: 1px solid var(--border); }
  .exp-item:last-child { border-bottom: none; padding-bottom: 0; }
  .exp-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 16px; margin-bottom: 14px; flex-wrap: wrap;
  }
  .exp-role { font-size: 1.02rem; font-weight: 600; }
  .exp-company { font-size: 0.88rem; color: var(--accent); margin-top: 2px; }
  .exp-period { font-size: 0.82rem; color: var(--text-soft); white-space: nowrap; padding-top: 3px; }
  .exp-bullets { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .exp-bullets li {
    font-size: 0.91rem; color: var(--text-soft);
    padding-left: 16px; position: relative; line-height: 1.55;
  }
  .exp-bullets li::before {
    content: '·'; position: absolute; left: 0;
    color: var(--accent); font-weight: 700; font-size: 1.1rem; top: -1px;
  }

  /* Education */
  .edu-list { display: flex; flex-direction: column; gap: 14px; }
  .edu-item {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 16px; padding: 18px 20px;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg);
  }
  .edu-degree { font-size: 0.97rem; font-weight: 600; }
  .edu-school { font-size: 0.86rem; color: var(--text-soft); margin-top: 3px; }
  .edu-gpa { font-size: 0.82rem; font-weight: 600; color: var(--accent); white-space: nowrap; }

  /* Job Fit */
  .fit-form { display: flex; flex-direction: column; gap: 14px; max-width: 680px; }
  #jd-input {
    width: 100%; padding: 14px;
    border: 1.5px solid var(--border); border-radius: var(--radius);
    font-family: var(--font); font-size: 0.92rem;
    resize: vertical; color: var(--text); background: var(--bg);
    transition: border-color 0.15s; line-height: 1.5;
  }
  #jd-input:focus { outline: none; border-color: var(--accent); }
  .fit-result {
    background: var(--bg-alt); border: 1.5px solid var(--border);
    border-radius: var(--radius); padding: 18px;
    font-size: 0.92rem; line-height: 1.65; color: var(--text);
  }
  .fit-loading { color: var(--text-soft); font-style: italic; }
  .hidden { display: none !important; }

  /* Footer */
  .footer { border-top: 1px solid var(--border); padding: 28px 0; }
  .footer-inner {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 0.86rem; color: var(--text-soft); gap: 16px; flex-wrap: wrap;
  }
  .footer-inner a { color: var(--text-soft); }
  .footer-inner a:hover { color: var(--text); text-decoration: none; }
  .footer-links { display: flex; gap: 20px; }

  @media (max-width: 640px) {
    .hero-name { font-size: 2.2rem; }
    .nav-links a:not(.nav-cta) { display: none; }
    .sentinel-header { flex-direction: column; }
    .sentinel-card { padding: 20px; }
    .exp-header { flex-direction: column; }
    .edu-item { flex-direction: column; }
    .footer-inner { flex-direction: column; text-align: center; }
  }
</style>

</body>
</html>
